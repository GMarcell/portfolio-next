# ── Required for production ───────────────────────────────────
#
# Resend API key for sending contact form emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# ── Distributed rate limiting (recommended for production) ────
#
# When set, the contact form uses Upstash Redis for rate limiting
# that works across all serverless function invocations.
# When unset, falls back to per-process in-memory (single invocation only).
# Get these at https://console.upstash.com → select your database → REST API
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional ──────────────────────────────────────────────────
#
# Override the email address that receives contact form submissions.
# Defaults to grand1310marcell@gmail.com
# CONTACT_EMAIL=your@email.com
