# ── Grand Marcell Portfolio — environment variables ──────────────
# Copy this file to `.env.local` and fill in the values:
#
#   cp .env.example .env.local
#
# Uncommented variables below are REQUIRED — the production build
# (`npm run build`) fails if they are missing. Commented variables
# are OPTIONAL — the app degrades gracefully when they are absent.

# ── Required ─────────────────────────────────────────────────────
# Resend API key for the contact form. Create an account at
# https://resend.com and generate a key under API Keys.
# NOTE: For local development you may temporarily comment this line
# out — the contact form will return a 500 until a key is provided.
RESEND_API_KEY=

# ── Optional ─────────────────────────────────────────────────────
# Where contact messages are delivered. Defaults to
# grand1310marcell@gmail.com.
# CONTACT_EMAIL=grand1310marcell@gmail.com

# "From" address shown on contact emails. Must use a domain verified
# in Resend, e.g. "Portfolio Contact <contact@grandmarcell.dev>".
# Until this is set, emails fall back to Resend's sandbox address
# (onboarding@resend.dev), which will not deliver reliably.
# CONTACT_FROM_EMAIL="Portfolio Contact <contact@grandmarcell.dev>"

# Upstash Redis — enables distributed rate limiting across serverless
# invocations (recommended for production on Vercel). When unset, the
# app falls back to a per-process in-memory limiter (fine for dev).
# Create a free database at https://upstash.com and copy these values.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
